# =============================================================================
# Qwen3-TTS Server - VPS 业务层 Dockerfile（远程模式，不需要 GPU/torch）
# 与 wg-easy 容器共享网络命名空间，直接访问 WireGuard 隧道
# =============================================================================
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 使用国内镜像加速
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    libmagic1 \
    curl \
    openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /root/.ssh \
    && echo "StrictHostKeyChecking no" > /root/.ssh/config \
    && echo "UserKnownHostsFile /dev/null" >> /root/.ssh/config

WORKDIR /app

# 安装 Python 依赖
COPY requirements-vps.txt .
RUN pip install --default-timeout=100 -r requirements-vps.txt

# 复制应用代码
COPY app/ ./app/

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=60s --timeout=30s --start-period=15s --retries=5 \
    CMD curl -sf --max-time 10 http://localhost:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-keep-alive", "30"]
